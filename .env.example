# ==============================================================================
# OpenMemory Environment Configuration Example
# Copy to .env and configure for your environment.
# ==============================================================================

# Server port (default: 8080)
PORT=8080

# Storage directory (defaults to ~/.openmemory if unset)
OPENMEMORY_DATA_DIR=./data

# Optional: Bearer token required for querying memories (leave empty for local unrestricted access)
HUB_QUERY_TOKEN=

# Optional: Comma-separated list of Bearer tokens allowed to ingest sessions
HUB_INGEST_TOKENS=

# Optional: LLM configuration for background memory digest worker
# Compatible with OpenAI, DeepSeek, Ollama, vLLM, MiniMax, LMStudio
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
